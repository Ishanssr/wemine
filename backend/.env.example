# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wemine?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-this-to-a-different-random-64-char-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=4000
FRONTEND_URL="https://wemine.in"
NODE_ENV="production"

# Rate Limit
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Payment Gateways
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="rzp_live_secret_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Wemine <noreply@wemine.in>"

# Google OAuth
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_CALLBACK_URL="https://wemine.in/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."
GITHUB_CALLBACK_URL="https://wemine.in/api/auth/github/callback"

# Cloudinary (optional — falls back to local disk)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Base URL (for upload fallback URLs)
BASE_URL="https://api.wemine.in"
